{
    "compilerOptions": {
        "target":            "ES2022",
        "module":            "ES2022",
        "moduleResolution":  "Bundler",
        "lib":               ["ES2022"],
        "types":             ["@cloudflare/workers-types"],
        "strict":            true,
        "noUncheckedIndexedAccess": true,
        "noImplicitOverride":       true,
        "noFallthroughCasesInSwitch": true,
        "esModuleInterop":   true,
        "skipLibCheck":      true,
        "isolatedModules":   true,
        "noEmit":            true
    },
    "include": ["worker.ts"]
}
