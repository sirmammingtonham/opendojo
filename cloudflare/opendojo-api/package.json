{
    "name":     "opendojo-api",
    "version":  "0.1.0",
    "private":  true,
    "description": "Cloudflare Worker that fronts the OpenDojo Supabase project with per-IP rate limits.",
    "scripts": {
        "deploy":  "wrangler deploy",
        "dev":     "wrangler dev",
        "bundle":  "wrangler deploy --dry-run --outdir dist",
        "typecheck": "tsc --noEmit"
    },
    "devDependencies": {
        "@cloudflare/workers-types": "^4.20260101.0",
        "typescript":                "^5.4.0",
        "wrangler":                  "^3.80.0"
    }
}
